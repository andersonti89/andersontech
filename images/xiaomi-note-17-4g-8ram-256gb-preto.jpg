</style>      

        <!-- Script to place list-and-share-box-container based on weblab treatments -->
        <script type="text/javascript">(function(f) {var _np=(window.P._namespace("DetailPageTellAFriendTemplates"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) {
            P.when('jQuery','SocialShareWidgetAUI').execute('tellAFriendBox', function($) {
                $(function() {
                    var OLD_WIDGET = $("[id$='mageBlock_feature_div']").find("[data-action='ssf-share-icon']");
                    if(OLD_WIDGET.length) { OLD_WIDGET.remove() }

                    var LIST_AND_SHARE_WIDGET = $('#list-and-share-box-container');
                    var SHARE_WIDGET = $('#ssf-primary-widget-desktop');
                    var AUDIBLE_TITLE = $('#audibleproducttitle_feature_div');

                    // Keeping audible logic as it is since social proofing is not implemented
                    if (AUDIBLE_TITLE.length > 0) {
                        AUDIBLE_TITLE.prepend(SHARE_WIDGET);
                    } else {
                        LIST_AND_SHARE_WIDGET.css("display","flex");
                        var shareWidgetTreatment = LIST_AND_SHARE_WIDGET.attr('shareWidgetParams');
                        var heartIconTreatment = LIST_AND_SHARE_WIDGET.attr('heartIconParams');

                        // For T1 and T3 move share and heart beside Badge and Insights
                        if (shareWidgetTreatment === 'T1' || shareWidgetTreatment === 'T3') {
                            var TITLE_BLOCK = $("#socialProofingAsinFaceout_feature_div");
                            TITLE_BLOCK.append(LIST_AND_SHARE_WIDGET);
                            LIST_AND_SHARE_WIDGET.toggleClass('list-and-share-box list-and-share-box-title');
                            SHARE_WIDGET.children('div').addClass('ssf-horizontal-list-share');
                        } else if (shareWidgetTreatment === 'T2' || shareWidgetTreatment === 'T4') {
                            // For T2 and T4 move share and heart in bottom right corner (outside product image)
                            var IMAGEBLOCK = $("[id$='main-image-container']").parent();
                            IMAGEBLOCK.after(LIST_AND_SHARE_WIDGET);
                            SHARE_WIDGET.children('div').addClass('ssf-horizontal-list-share');
                        } else if (heartIconTreatment === 'T1') {
                            // For heartIconTreatment T1 move heart above share widget in top right corner image
                            var LEFT_COL = $("#ppd #leftCol");
                            var IMAGEBLOCK_FEATURE = $("[id$='mageBlock_feature_div']");

                            if (LEFT_COL.css('position') !== "sticky") {
                                IMAGEBLOCK_FEATURE.css('position','relative');
                            }
                            IMAGEBLOCK_FEATURE.prepend(LIST_AND_SHARE_WIDGET);
                            LIST_AND_SHARE_WIDGET.removeClass('list-and-share-box');

                            var HEART_ICON = $('.lists-share-heart-icon');
                            SHARE_WIDGET.after(HEART_ICON);
                            SHARE_WIDGET.addClass('lists-share-vertical-top');

                            var repositionForHeart = function() {
                                if (HEART_ICON.find('.lists-framework-heart-background').length > 0) {
                                    SHARE_WIDGET.removeClass('lists-share-vertical-top').addClass('lists-share-vertical');
                                    HEART_ICON.addClass('lists-heart-vertical');
                                    return true;
                                }
                                return false;
                            };

                            if (!repositionForHeart()) {
                                var observer = new MutationObserver(function() {
                                    if (repositionForHeart()) {
                                        observer.disconnect();
                                    }
                                });
                                observer.observe(HEART_ICON[0], { childList: true, subtree: true });
                            }
                        }
                    }

                    P.when('SocialShareWidgetAUI').execute(function(SocialShareWidget){
                        SocialShareWidget.init();
                        if (AUDIBLE_TITLE.length > 0) {
                            SHARE_WIDGET.find('.ssf-background').toggleClass('ssf-background ssf-background-float');
                            SHARE_WIDGET.find('.ssf-share-btn').toggleClass('ssf-share-btn ssf-share-btn-float');
                        }
                    });
                });
            });
        }));</script>                    </div>                                 </div>
