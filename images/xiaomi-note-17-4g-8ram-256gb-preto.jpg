    .list-and-share-box-title {
        display: flex;
        flex-direction: row;
        float: right;
        margin-top: -35px;
    }

    #list-and-share-box-container .lists-framework-heart-background {
        width: 33.6px;
        height: 33.6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    #list-and-share-box-container .lists-framework-unfilled-heart-icon,
    #list-and-share-box-container .lists-framework-filled-heart-icon {
        width: 24px;
        height: 24px;
    }

    .lists-heart-vertical {
        position: absolute;
        top: 9px;
        inset-inline-end: 9px;
        z-index: 3;
    }

    .lists-share-vertical {
        position: absolute;
        top: 44px;
        inset-inline-end: 0;
        z-index: 3;
    }

    .lists-share-vertical-top {
        position: absolute;
        top: 0;
        inset-inline-end: 0;
        z-index: 3;
